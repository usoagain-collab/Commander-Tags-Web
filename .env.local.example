# Copy this file to .env.local and fill in the values (never commit .env.local).
# Find them in the Supabase dashboard: Project Settings -> API Keys, and the Connect button for the database URL.

# Public: safe in the browser. Row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret: server only. Bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# Secret: direct Postgres connection used by the daily import job (bulk COPY).
# Use the "Session pooler" connection string (works over IPv4).
SUPABASE_DB_URL=
